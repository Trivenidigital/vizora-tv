# Dependencies
node_modules/

# Build output
dist/
dist-tv/
build/

# TV packages
*.wgt
*.ipk

# Capacitor generated files (track android/ since we have custom native code)
# android/  -- DO NOT gitignore: contains BootReceiver, SecureStoragePlugin, CrashRecoveryHandler
ios/

# Android build artifacts (still ignore these)
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
android/.gradle/
android/.idea/
android/local.properties
android/keystore.properties
android/*.keystore
android/*.jks

# Android signing material — NEVER commit, anywhere in the tree.
# The three patterns above are anchored to android/; these are not, so a
# keystore dropped in any other directory is still excluded. A private repo is
# not a key vault: repo access spreads to developers, CI and integrations.
*.jks
*.keystore
*.p12
keystore.properties

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# APK outputs
*.apk
*.aab
