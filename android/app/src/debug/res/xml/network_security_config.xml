<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DEBUG-ONLY. Trust the system CA store PLUS any USER-installed CA, so the
         emulator/device can E2E-test through a local TLS-inspecting proxy (Norton
         "Web/Mail Shield", a corporate MITM proxy, Charles, mitmproxy, ...) that
         re-signs vizora.cloud. Without a trusted proxy root, requests fail with
         SSLHandshakeException / "Trust anchor not found". Apps target API 24+,
         where user CAs are NOT trusted by default — hence this debug override.
         One-time setup: install your proxy's root as a *user* certificate on the
         emulator (Settings > Security > Encryption & credentials > Install a
         certificate > CA certificate, or `adb push` the PEM and install). This is
         machine-agnostic: no specific cert is bundled. Real devices on normal
         networks see vizora.cloud's real Let's Encrypt cert, and the RELEASE build
         is system-only (src/release), so production trust is unaffected. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext (HTTP) traffic to the Android emulator host alias
         and localhost for development (smoke build / mock backend). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
