# Emulator smoke config — points the app at scripts/mock-backend.mjs on the
# host (10.0.2.2 = emulator alias for host loopback). Build with:
#   npx vite build --mode smoke
VITE_API_URL=http://10.0.2.2:3000
VITE_REALTIME_URL=http://10.0.2.2:3002
VITE_DASHBOARD_URL=http://10.0.2.2:3001
VITE_SENTRY_DSN=
