# Vizora Android TV Display Configuration
# Copy this file to .env and update the values.
#
# LOCAL DEVELOPMENT ONLY. These variables no longer decide what a release build is
# compiled against. Release modes (`production`, which becomes the Android APK, and
# `tv`, which becomes the Tizen/webOS app) read their DEFAULT backend origins from
# the committed release-origins.json and REFUSE TO BUILD if anything here disagrees.
#
# That is deliberate: until 1.3.13 these values came from this gitignored file with
# a fallback to a *different* environment, so the same commit could ship APKs
# pointing at different backends. See release-origins.json and vizora-tv#18.
#
# To build against something else, use a non-release mode:
#   vite build --mode staging
#
# The values below are the historical vizora.io defaults, kept as an illustration
# of the shape. Production ships against vizora.cloud — see release-origins.json.

# API Server URL
VITE_API_URL=https://api.vizora.io

# Realtime WebSocket Server URL
VITE_REALTIME_URL=wss://realtime.vizora.io

# Dashboard URL (for QR code pairing)
VITE_DASHBOARD_URL=https://dashboard.vizora.io

# Sentry crash reporting DSN (leave empty to disable crash reporting).
# Not an origin — still env-driven in every mode.
VITE_SENTRY_DSN=
